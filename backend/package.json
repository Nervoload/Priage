  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@nestjs/cli": "11.0.14",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.0.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^3.2.4",
