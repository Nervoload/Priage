    "test:logging:verbose": "node scripts/test-logging.js --verbose",
    "test:logging:db": "node scripts/test-logging.js",
    "test:unit": "vitest run",
    "test:security": "node scripts/security-regression.js",
    "test:load": "node scripts/load-regression.js",
    "test:assurance": "node scripts/assurance-regression.js",
