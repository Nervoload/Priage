    "clinic:publish-legal-document": "node scripts/publish-clinic-legal-document.js",
    "jobs:remove-obsolete-triage-repeat": "node scripts/remove-obsolete-triage-repeat.js",
    "test:clinic-intake-smoke": "node scripts/clinic-intake-smoke.js",
    "test:clinic-booking-smoke": "node scripts/clinic-booking-smoke.js",
    "test:clinic-entry-smoke": "node scripts/clinic-entry-smoke.js",
    "alerts:verify-activation": "node scripts/verify-alert-activation.js",
