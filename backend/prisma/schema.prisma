/// backend/prisma/schema.prisma
// Prisma schema file
// John Surette
// Date Created: Dec 8 2025
// Last Modified: Jan 14 2026
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum EncounterStatus {
  INTAKE // Clinic assessment underway; no appointment requested
  REQUESTED // Clinic appointment requested; not yet confirmed
  // Patient-facing
  EXPECTED                 // Patient registered but not yet arrived
  ADMITTED                 // Patient has arrived and is admitted
  CARE // Clinic physician is caring for the patient
  // In Hospital
  TRIAGE                   // Patient is in triage process  
  WAITING                  // Patient is waiting to be examined by medical staff
  
  // Terminal Status
  COMPLETE                 // Patient has been seen and treatment is complete  
  UNRESOLVED               // Patient left before completion
  CANCELLED                // Encounter was cancelled 
} 

enum Role { 
  ADMIN
  IT_ADMIN
  CLINICAL_ADMIN
  NURSE
  STAFF
  DOCTOR
}

enum InterviewAnswerEntryMode {
  PATIENT_SELF
  WALKIN_SELF
  STAFF_ASSISTED
}

enum LegalDocumentKind {
  TERMS
  PRIVACY
}

enum ClinicAppointmentStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  EXPIRED
  NO_SHOW
  COMPLETED
}

enum SenderType { # Needs more work...
  PATIENT
  USER
  SYSTEM
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertSource {
  MANUAL
  RULE_ENGINE
}

enum AlertResolutionReason {
  MANUAL
  RULE_CLEARED
}

enum AssetKind {
  IMAGE
}

enum AssetContext {
  INTAKE_IMAGE
  MESSAGE_ATTACHMENT
}

enum AssetStatus {
  QUARANTINED
  READY
  DELETE_PENDING
  REJECTED
  DELETED
}

enum AssetStorageProvider {
  LOCAL
  S3
}

enum AssetAccessMode {
  PROXY
  SIGNED_URL
}

enum LogRecordLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum SensitiveReadResource {
  ENCOUNTER_LIST
  ENCOUNTER_DETAIL
  HOSPITAL_QUEUE
  PATIENT_PROFILE
  MESSAGE_THREAD
  TRIAGE_ASSESSMENT
  ASSET_CONTENT
  ALERT
  BREAK_GLASS
}

enum EventType {
  // Inbound patient events
  ENCOUNTER_CREATED
  ARRIVAL_TIMEOUT
  STATUS_CHANGE

  MESSAGE_CREATED
  MESSAGE_READ
  MESSAGE_TRANSLATED

  // Triage events
  TRIAGE_CREATED
  TRIAGE_NOTE_ADDED
  TRIAGE_NOTE_UPDATED
  TRIAGE_COMPLETED
  CARE_UPDATED

  // Outbound patient events
  ALERT_CREATED
  ALERT_ESCALATED
  ALERT_ACKNOWLEDGED
  ALERT_RESOLVED
}

enum IntakeSessionStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum ContextSourceType {
  PATIENT
  PARTNER
  INSTITUTION
  AI
}

enum TrustTier {
  UNTRUSTED
  PARTNER_SUBMITTED
  INSTITUTION_TRUSTED
}

enum ReviewState {
  UNREVIEWED
  PATIENT_CONFIRMED
  STAFF_REVIEWED
  REJECTED
}

enum VisibilityScope {
  STORED_ONLY
  ADMISSIONS
  TRIAGE
  CLINICAL
}

enum SummaryProjectionKind {
  OPERATIONAL
  AI_DERIVED
  HUMAN_REVIEWED
}

enum PartnerCredentialStatus {
  ACTIVE
  DISABLED
}

enum IdempotencyRecordStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum WebhookSubscriptionStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model Encounter {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique
  clinicStartKey String? @unique
  clinicStartFingerprint String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    EncounterStatus @default(EXPECTED)
  chiefComplaint String?
  details        String?

  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId Int
  patient   PatientProfile @relation(fields: [patientId], references: [id])
  patientId Int

  currentTriageId Int? @unique
  currentTriage TriageAssessment? @relation("current_triage", fields: [currentTriageId], references: [id])


  currentCtasLevel    Int? // 1 (highest acuity) ... 5 (lowest)
  currentPriorityScore Int? // higher = sooner, your own scalar


  // Pipeline timestamps (denormalized for fast UI queries)
  expectedAt DateTime? @default(now())
  arrivedAt   DateTime?
  triagedAt   DateTime?
  waitingAt   DateTime?
  seenAt      DateTime?
  departedAt  DateTime?
  cancelledAt DateTime?

  triageAssessments TriageAssessment[]
  messages          Message[]
  events            EncounterEvent[]
  alerts            Alert[]
  assets            Asset[]
  patientSessions   PatientSession[]
  intakeSessions    IntakeSession[]
  contextItems      ContextItem[]
  summaryProjections SummaryProjection[]
  partnerReferences PartnerReference[]
  commandResults    CommandResult[]
  readCursors       EncounterReadCursor[]
  staffAccess       StaffEncounterAccess[]
  breakGlassAccess  BreakGlassAccess[]

  contact EncounterContact?
  visitAcceptance VisitAcceptance?
  clinicAssessmentGrants ClinicAssessmentGrant[]
  clinicAssessmentSessions ClinicAssessmentSession[]
  clinicAppointment ClinicAppointment?
  careSnapshots CareAssessmentSnapshot[]
  careNote CareNote?
  careComments CareAssessmentComment[]
  careOpenQuestions CareOpenQuestion[]
  careHandoffOverride CareHandoffOverride?
  careAiFeedback CareAiFeedback[]
  notifications NotificationOutbox[]

  // Tenant-hardening: enables compound FKs from child tables
  @@unique([id, hospitalId])

  // Indices for common views
  @@index([hospitalId, status])
  @@index([hospitalId, updatedAt])
  @@index([hospitalId, currentPriorityScore, updatedAt])
  @@index([patientId, createdAt])
}

model EncounterContact {
  id Int @id @default(autoincrement())
  encounterId Int @unique
  hospitalId Int
  email String?
  phone String?
  source String
  verifiedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  encounter Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)

  @@unique([encounterId, hospitalId])
  @@index([hospitalId, createdAt])
}

model CareAssessmentSnapshot {
  id Int @id @default(autoincrement())
  encounterId Int
  hospitalId Int
  version Int
  partial Boolean @default(false)
  content Json
  createdAt DateTime @default(now())
  encounter Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  comments CareAssessmentComment[]
  feedback CareAiFeedback[]

  @@unique([encounterId, version])
  @@unique([id, encounterId, hospitalId])
  @@index([hospitalId, createdAt])
}

model CareNote {
  id Int @id @default(autoincrement())
  encounterId Int @unique
  hospitalId Int
  text String @default("") @db.Text
  version Int @default(0)
  updatedByUserId Int?
  updatedAt DateTime @updatedAt
  finalizedAt DateTime?
  encounter Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  revisions CareNoteRevision[]

  @@unique([encounterId, hospitalId])
  @@index([hospitalId, updatedAt])
}

model CareNoteRevision {
  id Int @id @default(autoincrement())
  careNoteId Int
  version Int
  text String @db.Text
  kind String
  reason String? @db.Text
  actorUserId Int
  createdAt DateTime @default(now())
  careNote CareNote @relation(fields: [careNoteId], references: [id], onDelete: Cascade)

  @@unique([careNoteId, version])
}

model CareAssessmentComment {
  id Int @id @default(autoincrement())
  commandKey String? @unique
  encounterId Int
  hospitalId Int
  snapshotId Int
  segmentId String
  startOffset Int
  endOffset Int
  quote String @db.Text
  text String @db.Text
  version Int @default(1)
  resolvedAt DateTime?
  actorUserId Int
  updatedByUserId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  encounter Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  snapshot CareAssessmentSnapshot @relation(fields: [snapshotId, encounterId, hospitalId], references: [id, encounterId, hospitalId], onDelete: Cascade)
  revisions CareCommentRevision[]

  @@index([encounterId, snapshotId, segmentId])
}

model CareCommentRevision {
  id Int @id @default(autoincrement())
  commentId Int
  version Int
  text String @db.Text
  resolvedAt DateTime?
  actorUserId Int
  createdAt DateTime @default(now())
  comment CareAssessmentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, version])
}

model CareOpenQuestion {
  id Int @id @default(autoincrement())
  commandKey String? @unique
  encounterId Int
  hospitalId Int
  text String @db.Text
  addressedAt DateTime?
  /// Set when the question came from the snapshot's "Ask in the room" list.
  snapshotId Int?
  sourceSegmentId String?
  /// What the patient said when asked in the room, in the clinician's words.
  answerText String? @db.Text
  version Int @default(1)
  actorUserId Int
  updatedByUserId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  encounter Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)

  @@unique([encounterId, snapshotId, sourceSegmentId])
  @@index([encounterId, createdAt])
}

enum CareAiFeedbackKind {
  USEFUL
  NOT_RIGHT
  MISSING
}

/// A clinician's verdict on one generated Care item, or a note that a section
/// missed something. Used to evaluate the handoff rules and, later, the model.
model CareAiFeedback {
  id Int @id @default(autoincrement())
  encounterId Int
  hospitalId Int
  snapshotId Int
  /// The segment id, or "missing:<section>" for a Something missing note.
  targetKey String
  segmentId String?
  sectionKey String
  ruleId String?
  generatorKind String
  generatorVersion String?
  kind CareAiFeedbackKind
  note String? @db.Text
  actorUserId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  encounter Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  snapshot CareAssessmentSnapshot @relation(fields: [snapshotId, encounterId, hospitalId], references: [id, encounterId, hospitalId], onDelete: Cascade)

  @@unique([snapshotId, actorUserId, targetKey])
  @@index([hospitalId, createdAt])
}

model CareHandoffOverride {
  id Int @id @default(autoincrement())
  encounterId Int @unique
  hospitalId Int
  reason String @db.Text
  actorUserId Int
  createdAt DateTime @default(now())
  encounter Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)

  @@unique([encounterId, hospitalId])
  @@index([hospitalId, createdAt])
}

model ClinicAssessmentGrant {
  id Int @id @default(autoincrement())
  tokenHash String @unique
  encounterId Int
  hospitalId Int
  issuedByUserId Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  encounter Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  issuedByUser User @relation(fields: [issuedByUserId], references: [id], onDelete: Restrict)
  session ClinicAssessmentSession?

  @@index([encounterId, expiresAt])
  @@index([hospitalId, createdAt])
}

model ClinicAssessmentSession {
  id Int @id @default(autoincrement())
  tokenHash String @unique
  grantId Int @unique
  encounterId Int
  hospitalId Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  grant ClinicAssessmentGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  encounter Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)

  @@index([encounterId, expiresAt])
}

model ClinicSchedule {
  hospitalId Int @id
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  timezone String
  slotMinutes Int
  capacity Int
  holdMinutes Int
  weeklyWindows Json
  updatedAt DateTime @updatedAt
}

model ClinicScheduleOverride {
  id Int @id @default(autoincrement())
  hospitalId Int
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  localDate String
  windows Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, localDate])
}

model ClinicScheduleBlock {
  id Int @id @default(autoincrement())
  hospitalId Int
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  startAt DateTime
  endAt DateTime
  reason String
  createdByUserId Int
  createdByUser User @relation("ClinicScheduleBlockCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([hospitalId, startAt, endAt])
}

model ClinicAppointment {
  id Int @id @default(autoincrement())
  publicId String @unique
  hospitalId Int
  encounterId Int @unique
  encounter Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  status ClinicAppointmentStatus @default(REQUESTED)
  requestedStartAt DateTime
  confirmedStartAt DateTime?
  endAt DateTime
  timezone String
  slotMinutes Int
  expiresAt DateTime?
  revision Int @default(1)
  requestKey String @unique
  requestedAt DateTime @default(now())
  confirmedAt DateTime?
  confirmedByUserId Int?
  confirmedByUser User? @relation("ClinicAppointmentConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  resolvedAt DateTime?
  resolvedByUserId Int?
  resolvedByUser User? @relation("ClinicAppointmentResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actions ClinicAppointmentAction[]
  notifications NotificationOutbox[]
  recoveryChallenges AppointmentRecoveryChallenge[]
  recoverySessions AppointmentRecoverySession[]

  @@unique([encounterId, hospitalId])
  @@unique([id, hospitalId])
  @@index([hospitalId, status, requestedStartAt])
  @@index([hospitalId, expiresAt])
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  ACCEPTED
  DELIVERED
  FAILED
  CANCELLED
  NEEDS_REVIEW
}

model ClinicNotificationSettings {
  hospitalId Int @id
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  enabled Boolean @default(false)
  replyTo String?
  contactPhone String?
  reminderMinutes Json @default("[1440,120]")
  version Int @default(1)
  updatedByUserId Int?
  updatedAt DateTime @updatedAt
}

model NotificationOutbox {
  id String @id @default(uuid())
  hospitalId Int
  encounterId Int?
  encounter Encounter? @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  appointmentId Int?
  appointment ClinicAppointment? @relation(fields: [appointmentId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  challengeId String? @unique
  challenge AppointmentRecoveryChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  appointmentRevision Int?
  contactVersion Int?
  purpose String
  dedupeKey String @unique
  recipientEmail String
  dueAt DateTime
  expiresAt DateTime?
  templateVersion String @default("clinic-email-v1")
  status NotificationStatus @default(QUEUED)
  payload Json?
  secretEncrypted String?
  payloadEncrypted String?
  firstAttemptAt DateTime?
  attemptCount Int @default(0)
  claimToken String?
  claimedAt DateTime?
  provider String?
  providerEmailId String? @unique
  acceptedAt DateTime?
  deliveredAt DateTime?
  lastEventAt DateTime?
  lastError String?
  cancelledReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attempts NotificationAttempt[]

  @@unique([id, hospitalId])
  @@index([status, dueAt])
  @@index([hospitalId, appointmentId, createdAt])
}

model NotificationAttempt {
  id Int @id @default(autoincrement())
  notificationId String
  hospitalId Int
  notification NotificationOutbox @relation(fields: [notificationId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  outcome String
  errorCode String?
  createdAt DateTime @default(now())

  @@index([notificationId, createdAt])
}

model NotificationWebhookReceipt {
  id String @id
  providerEmailId String
  eventType String
  eventAt DateTime
  receivedAt DateTime @default(now())
}

model NotificationSuppression {
  id Int @id @default(autoincrement())
  hospitalId Int
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  email String
  reason String
  createdAt DateTime @default(now())

  @@unique([hospitalId, email])
}

model AppointmentRecoveryChallenge {
  id String @id @default(uuid())
  hospitalId Int
  appointmentId Int
  appointment ClinicAppointment @relation(fields: [appointmentId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  contactVersion Int
  codeHash String
  attempts Int @default(0)
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  notification NotificationOutbox?

  @@index([hospitalId, appointmentId])
  @@index([expiresAt])
}

model AppointmentRecoverySession {
  id String @id @default(uuid())
  tokenHash String @unique
  hospitalId Int
  appointmentId Int
  appointment ClinicAppointment @relation(fields: [appointmentId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  contactVersion Int
  verifiedAt DateTime
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([hospitalId, appointmentId])
  @@index([expiresAt])
}

model RecoveryRateLimit {
  key String @id
  windowStartAt DateTime
  count Int
  lastRequestAt DateTime
}

model ClinicAppointmentAction {
  id Int @id @default(autoincrement())
  appointmentId Int
  hospitalId Int
  appointment ClinicAppointment @relation(fields: [appointmentId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  commandKey String @unique
  kind String
  requestedStartAt DateTime?
  actorPatientId Int?
  actorUserId Int?
  revision Int
  createdAt DateTime @default(now())

  @@index([hospitalId, appointmentId, createdAt])
}

model EncounterEvent {
  id        Int      @id @default(autoincrement())
  type      EventType
  metadata  Json?
  createdAt DateTime @default(now())

  actorUserId    Int?
  actorPatientId Int?

  // Optional “outbox processing” 
  processedAt DateTime?
  claimedAt DateTime?
  claimToken String?
  attemptCount Int @default(0)
  lastError String?
  deadLetteredAt DateTime?

  // Tenant-safe encounter link
  encounterId Int
  hospitalId  Int
  encounter   Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  webhookDeliveries WebhookDelivery[]

  @@index([encounterId, createdAt])
  @@index([hospitalId, createdAt])
  @@index([processedAt])
  @@index([deadLetteredAt, processedAt, createdAt])
  @@index([claimedAt])
}

//---------------------------------------------------------------------//
//                    HOSPITAL-SIDE SCHEMA 
//---------------------------------------------------------------------//
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  mfaEnabled Boolean @default(false)
  mfaSecretEncrypted String?
  ssoIssuer String?
  ssoSubject String?

  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId Int

  triageAssessments TriageAssessment[]
  messages          Message[]
  acknowledgedAlerts Alert[] @relation("alert_ack_by")
  resolvedAlerts     Alert[] @relation("alert_resolve_by")
  readCursors        EncounterReadCursor[]
  assets             Asset[]
  staffSessions      StaffSession[]
  hospitalMemberships HospitalMembership[]
  encounterAccess    StaffEncounterAccess[] @relation("care_team_user")
  grantedEncounterAccess StaffEncounterAccess[] @relation("care_team_granted_by")
  breakGlassAccess   BreakGlassAccess[]
  alertEscalationExceptions AlertEscalationException[]
  issuedClinicAssessmentGrants ClinicAssessmentGrant[]
  assistedContextItems ContextItem[] @relation("AssistedContextItems")
  clinicScheduleBlocks ClinicScheduleBlock[] @relation("ClinicScheduleBlockCreator")
  confirmedClinicAppointments ClinicAppointment[] @relation("ClinicAppointmentConfirmer")
  resolvedClinicAppointments ClinicAppointment[] @relation("ClinicAppointmentResolver")

  @@unique([ssoIssuer, ssoSubject])
  @@index([hospitalId, role])
}

model HospitalMembership {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  disabledAt DateTime?
  role      Role

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId Int
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staffSessions StaffSession[]

  @@unique([userId, hospitalId])
  @@index([hospitalId, role, isActive])
  @@index([userId, isActive])
}

model StaffSession {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime?
  lastSeenAt DateTime?
  revokedAt DateTime?
  revokedReason String?
  createdIp String?
  createdUserAgent String?
  lastSeenIp String?
  lastSeenUserAgent String?
  deviceIdHash String?
  deviceFingerprintHash String?
  authMethod String @default("password")
  mfaVerifiedAt DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId Int?
  membership HospitalMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([membershipId, createdAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([deviceIdHash])
}

model StaffEncounterAccess {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  reason      String?

  encounterId Int
  hospitalId  Int
  encounter   Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)

  userId      Int
  user        User @relation("care_team_user", fields: [userId], references: [id], onDelete: Cascade)

  grantedByUserId Int
  grantedBy       User @relation("care_team_granted_by", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@unique([encounterId, userId])
  @@index([hospitalId, userId, expiresAt])
}

model BreakGlassAccess {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  reason      String
  correlationId String?

  encounterId Int
  hospitalId  Int
  encounter   Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)

  userId      Int
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([encounterId, userId, expiresAt])
  @@index([hospitalId, createdAt])
}

model Hospital {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  users      User[]
  memberships HospitalMembership[]
  encounters Encounter[]
  intakeSessions IntakeSession[]
  contextItems ContextItem[]
  partnerCredentials PartnerCredential[]
  webhookSubscriptions WebhookSubscription[]
  alertEscalationException AlertEscalationException?
  config     HospitalConfig?
  clinicSchedule ClinicSchedule?
  clinicScheduleOverrides ClinicScheduleOverride[]
  clinicScheduleBlocks ClinicScheduleBlock[]
  clinicEntrySettings ClinicEntrySettings?
  clinicEntryAliases ClinicEntryAlias[]
  notificationSettings ClinicNotificationSettings?
  clinicQuestionnaireVersions ClinicQuestionnaireVersion[]
  notificationSuppressions NotificationSuppression[]

  @@index([slug])
}

model ClinicEntrySettings {
  hospitalId Int @id
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  canonicalAlias String @unique
  directoryListed Boolean @default(false)
  acceptsWalkIns Boolean @default(false)
  updatedAt DateTime @updatedAt
}

/// A published version of a clinic's own questions, asked right after the
/// safety question in every assessment. Versions are never edited: publishing
/// adds the next one, and an assessment keeps the version it started with.
model ClinicQuestionnaireVersion {
  id Int @id @default(autoincrement())
  hospitalId Int
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  version Int
  /// ClinicQuestion[] (see clinic-questionnaire.ts). An empty list turns the questions off.
  questions Json
  publishedByUserId Int
  createdAt DateTime @default(now())

  @@unique([hospitalId, version])
}

model ClinicEntryAlias {
  alias String @id
  hospitalId Int
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([hospitalId])
}

model AlertEscalationException {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reason String
  expiresAt DateTime
  createdByUserId Int
  createdByUser User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  hospitalId Int @unique
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model HospitalConfig {
  hospitalId Int     @id
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  // Keep it flexible early; later you can normalize specific fields.
  config Json

  updatedAt DateTime @updatedAt
}

model TriageAssessment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) // assessedAt; name it however you like

  // Versioned triage assessment
  ctasLevel     Int // 1 highest ... 5 lowest
  priorityScore Int
  chiefComplaint String?
  painLevel     Int?       // 0–10 scale
  vitalSigns    Json?      // { bloodPressure, heartRate, temperature, respiratoryRate, oxygenSaturation }
  note          String?

  createdByUserId Int
  createdBy      User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  // Tenant-safe encounter link (compound FK)
  encounterId Int
  hospitalId  Int
  encounter   Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  
  // Backlink for "current triage"
  currentOf Encounter? @relation("current_triage")

  @@index([encounterId, createdAt])
  @@index([hospitalId, createdAt])
}

model Alert {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  type     String
  severity AlertSeverity @default(MEDIUM)
  source   AlertSource @default(MANUAL)
  ruleKey String?
  ruleVersion String?
  activeRuleDedupeKey String? @unique
  lastEvaluatedAt DateTime?
  conditionClearedAt DateTime?

  acknowledgedAt DateTime?
  acknowledgedByUserId Int?
  acknowledgedByUser   User? @relation("alert_ack_by", fields: [acknowledgedByUserId], references: [id], onDelete: Restrict)

  resolvedAt DateTime?
  resolvedByUserId Int?
  resolvedByUser   User? @relation("alert_resolve_by", fields: [resolvedByUserId], references: [id], onDelete: Restrict)
  resolutionReason AlertResolutionReason?

  metadata Json?

  // Tenant-safe encounter link
  encounterId Int
  hospitalId  Int
  encounter   Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)

  @@index([hospitalId, createdAt])
  @@index([encounterId, createdAt])
  @@index([hospitalId, acknowledgedAt])
  @@index([hospitalId, resolvedAt])
  @@index([hospitalId, source, conditionClearedAt])
  @@index([encounterId, ruleKey, createdAt])
}

//---------------------------------------------------------------------//
//                    PATIENT-SIDE SCHEMA 
//---------------------------------------------------------------------//
model PatientProfile {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  accountEnabled Boolean @default(true)
  createdAt DateTime @default(now())

  // Profile details

  firstName         String?
  lastName          String?
  phone             String?
  age               Int?
  gender            String?
  heightCm          Int?
  weightKg          Int?
  allergies         String?
  conditions        String?
  preferredLanguage String  @default("en")

  optionalHealthInfo Json?

  encounters Encounter[]
  messages   Message[]
  patientSessions PatientSession[]
  intakeSessions IntakeSession[]
  contextItems ContextItem[]
  readCursors EncounterReadCursor[]
  assets      Asset[]
  idempotencyRecords PatientIdempotencyRecord[]

  visitAcceptances VisitAcceptance[]
}

model PatientSession {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime?

  patientId Int
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  encounterId Int?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  intakeSessions IntakeSession[]
  assets      Asset[]
  idempotencyRecords PatientIdempotencyRecord[]

  @@index([patientId, createdAt])
  @@index([encounterId, createdAt])
  @@index([expiresAt])
}

model PatientIdempotencyRecord {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  completedAt DateTime?
  command   String
  idempotencyKey String
  requestFingerprint String
  status    IdempotencyRecordStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody Json?

  patientId Int
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  patientSessionId Int?
  patientSession   PatientSession? @relation(fields: [patientSessionId], references: [id], onDelete: SetNull)

  @@unique([patientId, command, idempotencyKey])
  @@index([patientId, createdAt])
  @@index([patientSessionId, createdAt])
  @@index([status, createdAt])
}

model SensitiveReadAuditLog {
  id                 Int                   @id @default(autoincrement())
  createdAt          DateTime              @default(now())
  resource           SensitiveReadResource
  action             String                @default("READ")
  correlationId      String?
  hospitalId          Int
  userId             Int
  encounterId         Int?
  patientId           Int?
  assetId            Int?
  triageAssessmentId Int?
  metadata           Json?

  @@index([createdAt])
  @@index([hospitalId, createdAt])
  @@index([userId, createdAt])
  @@index([encounterId, createdAt])
  @@index([patientId, createdAt])
  @@index([resource, createdAt])
}

model IntakeSession {
  id        Int                 @id @default(autoincrement())
  publicId  String              @unique
  status    IntakeSessionStatus @default(DRAFT)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  expiresAt DateTime?
  confirmedAt DateTime?
  cancelledAt DateTime?
  contactEmail String?

  patientId Int?
  patient   PatientProfile? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  hospitalId Int?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  encounterId Int?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  authSessionId Int?
  authSession   PatientSession? @relation(fields: [authSessionId], references: [id], onDelete: SetNull)

  contextItems ContextItem[]
  assets       Asset[]
  summaries    SummaryProjection[]
  partnerReferences PartnerReference[]
  commandResults CommandResult[]
  visitAcceptance VisitAcceptance?

  @@index([patientId, createdAt])
  @@index([hospitalId, createdAt])
  @@index([encounterId, createdAt])
  @@index([status, createdAt])
  @@index([authSessionId, status, createdAt])
}

model LegalDocumentVersion {
  id Int @id @default(autoincrement())
  kind LegalDocumentKind
  version String
  bodyMarkdown String @db.Text
  createdAt DateTime @default(now())
  publishedAt DateTime?
  termsAcceptances VisitAcceptance[] @relation("AcceptedTerms")
  privacyAcceptances VisitAcceptance[] @relation("AcceptedPrivacy")

  @@unique([kind, version])
  @@index([kind, publishedAt])
}

model VisitAcceptance {
  id Int @id @default(autoincrement())
  intakeSessionId Int @unique
  intakeSession IntakeSession @relation(fields: [intakeSessionId], references: [id], onDelete: Restrict)
  patientId Int
  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounterId Int? @unique
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  termsDocumentId Int
  termsDocument LegalDocumentVersion @relation("AcceptedTerms", fields: [termsDocumentId], references: [id], onDelete: Restrict)
  privacyDocumentId Int
  privacyDocument LegalDocumentVersion @relation("AcceptedPrivacy", fields: [privacyDocumentId], references: [id], onDelete: Restrict)
  acceptedAt DateTime @default(now())

  @@index([patientId, acceptedAt])
}

model EncounterReadCursor {
  id                Int      @id @default(autoincrement())
  encounterId       Int
  hospitalId        Int
  userId            Int?
  patientId         Int?
  lastReadMessageId Int?
  lastReadAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  encounter Encounter       @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient   PatientProfile? @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([encounterId, hospitalId])
  @@unique([encounterId, userId])
  @@unique([encounterId, patientId])
}

model Message {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  senderType SenderType

  // Exactly one of these should be set for non-system messages (enforce in app logic)
  createdByUserId    Int?
  createdByUser      User? @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByPatientId Int?
  createdByPatient   PatientProfile? @relation(fields: [createdByPatientId], references: [id], onDelete: Restrict)

  content  String
  original String?
  language String?

  // Tenant-safe encounter link
  encounterId Int
  hospitalId  Int
  encounter   Encounter @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)

  // Optional future-proofing
  isInternal Boolean @default(false)
  assets     Asset[]

  @@index([encounterId, createdAt])
  @@index([hospitalId, createdAt])
}

model Asset {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Store pointers/metadata, not the binary.
  kind             AssetKind    @default(IMAGE)
  context          AssetContext
  status           AssetStatus  @default(QUARANTINED)
  storageKey       String
  storageProvider  AssetStorageProvider @default(LOCAL)
  storageBucket    String?
  storageRegion    String?
  storageEndpoint  String?
  accessMode       AssetAccessMode @default(PROXY)
  retainedUntil    DateTime?
  archivedAt       DateTime?
  deletedAt        DateTime?
  scanStatus       String @default("NOT_SCANNED")
  scanDetail       String?
  deletionAttempts Int @default(0)
  deletionLastError String?
  encryption       String?
  originalFilename String
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?
  sha256     String?

  // Tenant-safe encounter link. Intake uploads can exist before an encounter is created.
  encounterId Int?
  hospitalId  Int?
  encounter   Encounter? @relation(fields: [encounterId, hospitalId], references: [id, hospitalId], onDelete: Cascade)

  patientSessionId Int?
  patientSession   PatientSession? @relation(fields: [patientSessionId], references: [id], onDelete: Cascade)

  intakeSessionId Int?
  intakeSession   IntakeSession? @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)

  messageId Int?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  createdByUserId Int?
  createdByUser   User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByPatientId Int?
  createdByPatient   PatientProfile? @relation(fields: [createdByPatientId], references: [id], onDelete: SetNull)

  @@index([encounterId, createdAt])
  @@index([hospitalId, createdAt])
  @@index([patientSessionId, createdAt])
  @@index([intakeSessionId, createdAt])
  @@index([messageId, createdAt])
  @@index([status])
  @@index([context])
}

model ContextItem {
  id        Int              @id @default(autoincrement())
  publicId  String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  itemType  String
  schemaVersion String       @default("v1")
  payload   Json
  answerEntryMode InterviewAnswerEntryMode?
  enteredByUserId Int?
  enteredByUser User? @relation("AssistedContextItems", fields: [enteredByUserId], references: [id], onDelete: SetNull)

  sourceType      ContextSourceType
  trustTier       TrustTier
  reviewState     ReviewState
  visibilityScope VisibilityScope

  hospitalId Int?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  patientId Int?
  patient   PatientProfile? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  intakeSessionId Int?
  intakeSession   IntakeSession? @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)

  encounterId Int?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  partnerId Int?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  supersedesId Int?
  supersedes   ContextItem? @relation("context_item_supersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy ContextItem[] @relation("context_item_supersession")

  @@index([intakeSessionId, createdAt])
  @@index([encounterId, createdAt])
  @@index([hospitalId, createdAt])
  @@index([patientId, createdAt])
  @@index([partnerId, createdAt])
  @@index([enteredByUserId, createdAt])
}

model SummaryProjection {
  id        Int                   @id @default(autoincrement())
  publicId  String                @unique
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  kind      SummaryProjectionKind
  content   Json
  active    Boolean               @default(true)

  sourceType      ContextSourceType
  trustTier       TrustTier
  reviewState     ReviewState
  visibilityScope VisibilityScope

  intakeSessionId Int?
  intakeSession   IntakeSession? @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)

  encounterId Int?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([intakeSessionId, createdAt])
  @@index([encounterId, createdAt])
  @@index([kind, createdAt])
}

model Partner {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  slug      String   @unique

  credentials PartnerCredential[]
  references  PartnerReference[]
  contextItems ContextItem[]

  @@index([slug])
}

model PartnerCredential {
  id        Int                     @id @default(autoincrement())
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  label     String
  keyPrefix String
  keyHash   String                  @unique
  scopes    String[]
  status    PartnerCredentialStatus @default(ACTIVE)

  partnerId Int
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  trustPolicy PartnerTrustPolicy?
  idempotencyRecords IdempotencyRecord[]
  commandResults      CommandResult[]
  webhookSubscriptions WebhookSubscription[]

  @@index([partnerId, createdAt])
  @@index([hospitalId, createdAt])
}

model PartnerTrustPolicy {
  id        Int             @id @default(autoincrement())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  partnerCredentialId Int  @unique
  partnerCredential   PartnerCredential @relation(fields: [partnerCredentialId], references: [id], onDelete: Cascade)

  defaultTrustTier              TrustTier       @default(PARTNER_SUBMITTED)
  defaultVisibilityScope        VisibilityScope @default(STORED_ONLY)
  requirePatientConfirmation    Boolean         @default(true)
  allowPreConfirmOperationalUse Boolean         @default(false)
}

model PartnerReference {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  referenceType  String
  referenceValue String

  partnerId Int
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  intakeSessionId Int?
  intakeSession   IntakeSession? @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)

  encounterId Int?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@unique([partnerId, referenceType, referenceValue])
  @@index([intakeSessionId, createdAt])
  @@index([encounterId, createdAt])
}

model CommandResult {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  command   String
  requestFingerprint String
  responseStatus Int
  responseBody Json

  partnerCredentialId Int
  partnerCredential   PartnerCredential @relation(fields: [partnerCredentialId], references: [id], onDelete: Cascade)

  intakeSessionId Int?
  intakeSession   IntakeSession? @relation(fields: [intakeSessionId], references: [id], onDelete: SetNull)

  encounterId Int?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  idempotencyRecords IdempotencyRecord[]

  @@index([partnerCredentialId, createdAt])
  @@index([intakeSessionId, createdAt])
  @@index([encounterId, createdAt])
}

model IdempotencyRecord {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  command   String
  idempotencyKey String
  requestFingerprint String
  status    IdempotencyRecordStatus @default(IN_PROGRESS)
  completedAt DateTime?

  partnerCredentialId Int
  partnerCredential   PartnerCredential @relation(fields: [partnerCredentialId], references: [id], onDelete: Cascade)

  commandResultId Int?
  commandResult   CommandResult? @relation(fields: [commandResultId], references: [id], onDelete: Cascade)

  @@unique([partnerCredentialId, command, idempotencyKey])
  @@index([commandResultId])
}

model WebhookSubscription {
  id        Int                       @id @default(autoincrement())
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  targetUrl String
  name String @default("Alert escalation")
  status    WebhookSubscriptionStatus @default(ACTIVE)
  eventTypes String[]
  secretHash String
  secretEncrypted String?
  secretKeyVersion Int @default(1)
  minimumSeverity AlertSeverity @default(HIGH)
  lastTestedAt DateTime?
  lastSuccessfulDeliveryAt DateTime?

  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  partnerCredentialId Int?
  partnerCredential   PartnerCredential? @relation(fields: [partnerCredentialId], references: [id], onDelete: SetNull)

  deliveries WebhookDelivery[]

  @@index([hospitalId, createdAt])
  @@index([partnerCredentialId, createdAt])
}

model WebhookDelivery {
  id        Int                   @id @default(autoincrement())
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  status    WebhookDeliveryStatus @default(PENDING)
  eventId String @unique @default(uuid())
  eventType String
  payload   Json
  attempts  Int                   @default(0)
  nextAttemptAt DateTime @default(now())
  claimedAt DateTime?
  claimToken String?
  responseStatus Int?
  deliveredAt DateTime?
  lastAttemptAt DateTime?
  lastError String?

  webhookSubscriptionId Int
  webhookSubscription   WebhookSubscription @relation(fields: [webhookSubscriptionId], references: [id], onDelete: Cascade)

  sourceEventId Int?
  sourceEvent EncounterEvent? @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)

  @@index([webhookSubscriptionId, createdAt])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([claimToken])
  @@unique([webhookSubscriptionId, sourceEventId])
}

model LogRecord {
  id            Int            @id @default(autoincrement())
  createdAt     DateTime       @default(now())
  level         LogRecordLevel
  message       String
  correlationId String?
  service       String
  operation     String
  userId        Int?
  patientId     Int?
  hospitalId    Int?
  encounterId   Int?
  data          Json?
  errorMessage  String?
  errorStack    String?
  errorCode     String?

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([correlationId, createdAt])
  @@index([service, operation, createdAt])
  @@index([hospitalId, createdAt])
  @@index([encounterId, createdAt])
  @@index([userId, createdAt])
  @@index([patientId, createdAt])
}

model ErrorReportSnapshot {
  id              Int      @id @default(autoincrement())
  reportId        String   @unique
  correlationId   String
  generatedAt     DateTime @default(now())
  summary         String
  errorCount      Int
  logCount        Int
  payload         Json
  createdByUserId Int?
  hospitalId      Int?

  @@index([correlationId, generatedAt])
  @@index([hospitalId, generatedAt])
  @@index([generatedAt])
}
