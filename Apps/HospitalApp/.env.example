# HospitalApp environment variables (Vite)
# Copy this to .env and adjust values for your setup.
# These are loaded by Vite at build time via import.meta.env.VITE_*

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:3000

# Static sales demo mode bypasses backend calls and uses browser-local demo data.
# VITE_DEMO_MODE=static
# VITE_DEMO_EVENT_ENDPOINT=
