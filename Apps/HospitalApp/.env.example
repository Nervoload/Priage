# HospitalApp environment variables (Vite)
# Copy this to .env and adjust values for your setup.
# These are loaded by Vite at build time via import.meta.env.VITE_*

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:3000
# Optional ED build prefill. The restricted clinic preview requires this value.
VITE_HOSPITAL_SLUG=
# Restricted clinic preview build: set both flags and the pinned slug. The
# backend separately enforces PILOT_CLINIC_ID and CLINIC_PREVIEW_ENABLED.
# VITE_CLINIC_PILOT_MODE=true
# VITE_HOSPITAL_SLUG=pilot-clinic-slug
# VITE_PATIENT_APP_URL=https://patient-staging.example.ca
