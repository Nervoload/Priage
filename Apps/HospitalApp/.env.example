# HospitalApp environment variables (Vite)
# Copy this to .env and adjust values for your setup.
# These are loaded by Vite at build time via import.meta.env.VITE_*

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:3000
# Optional deployment-scoped clinic prefill. Users can still enter a clinic slug.
VITE_HOSPITAL_SLUG=
